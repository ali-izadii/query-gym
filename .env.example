# Copy to .env and adjust if ports clash.
POSTGRES_USER=qp
POSTGRES_PASSWORD=qp
POSTGRES_DB=querypractice
POSTGRES_PORT=5433

PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Data volume knob used by the seed scripts.
# 1  -> ~250k orders   (fast, ~1-2 min, good default for git clones)
# 5  -> ~1.2M orders   (a few minutes)
# 20 -> ~5M orders     (heavy; real partition pruning / parallel plans)
SCALE=1
